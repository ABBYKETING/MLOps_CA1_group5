# SP-buy Fraud Detection
# Project-level client configuration template
#
# This file contains no actual credentials.
# Obtain authorised connection settings from the team.
# Set these values as environment variables before running the application.
# Copying this file to .env alone does not automatically load the variables.

# ==========================================
# MLflow Client Configuration
# ==========================================

# Official team server: use the authorised HTTPS tracking endpoint.
# Local official server (host machine): http://127.0.0.1:5006
# Isolated RDS-backed test server: http://127.0.0.1:5007
MLFLOW_TRACKING_URI=

# Use the credentials for the selected MLflow server.
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# ==========================================
# AWS RDS Business Database Configuration
# ==========================================

# Obtain the authorised RDS endpoint from the database owner.
DB_HOST=
DB_PORT=3306

# Use your authorised business database account.
DB_USER=
DB_PASSWORD=
DB_NAME=spbuy

# Do not use the isolated MLflow metadata database account
# for ETL, analytics or fraud detection business data.
#
# Never commit populated configuration files or credentials.
